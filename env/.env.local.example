# Local stage (developer machine). Single-member replica set, synthetic data only.
# Generate the three files under ./secrets (ignored by Git) before the first start; see README.
DLC_MONGO_REPLICA_SET=rs0
PLATFORM_NETWORK_NAME=platform
DLC_MONGO_ROOT_USER=root
DLC_MONGO_ROOT_PASSWORD_FILE=./secrets/mongo-root-password.txt
DLC_MONGO_KEYFILE=./secrets/mongo-keyfile
DLC_CLINICAL_MIGRATOR_PASSWORD_FILE=./secrets/clinical-migrator-password.txt
