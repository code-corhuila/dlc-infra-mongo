# main stage. Not deployed yet: hosting and replica-set size are pending decision P-01.
# Never put a secret value here. Each *_FILE points to a file materialized from AWS Secrets Manager;
# the references below are names only, and their bindings are pending until the stage exists.
DLC_MONGO_REPLICA_SET=rs0
CLINICAL_DATA_NETWORK_NAME=clinical-data
DLC_MONGO_ROOT_USER=root
DLC_MONGO_ROOT_PASSWORD_FILE=/run/dlc-secrets/mongo-root-password      # ref: dlc/main/clinical-mongo/root-password
DLC_MONGO_KEYFILE=/run/dlc-secrets/mongo-keyfile                      # ref: dlc/main/clinical-mongo/keyfile
DLC_CLINICAL_MIGRATOR_PASSWORD_FILE=/run/dlc-secrets/clinical-migrator-password   # ref: dlc/main/clinical-mongo/migrator-password
DLC_CLINICAL_RUNTIME_PASSWORD_FILE=/run/dlc-secrets/clinical-runtime-password       # ref: dlc/main/clinical-mongo/runtime-password
