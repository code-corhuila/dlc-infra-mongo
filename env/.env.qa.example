# qa stage. Not deployed yet: hosting and replica-set size are pending decision P-01.
# Never put a secret value here. Each *_FILE points to a file materialized from AWS Secrets Manager;
# the references below are names only, and their bindings are pending until the stage exists.
DLC_MONGO_REPLICA_SET=rs0
CLINICAL_DATA_NETWORK_NAME=clinical-data
DLC_MONGO_ROOT_USER=root
DLC_MONGO_ROOT_PASSWORD_FILE=/run/dlc-secrets/mongo-root-password      # ref: dlc/qa/clinical-mongo/root-password
DLC_MONGO_KEYFILE=/run/dlc-secrets/mongo-keyfile                      # ref: dlc/qa/clinical-mongo/keyfile
DLC_CLINICAL_MIGRATOR_PASSWORD_FILE=/run/dlc-secrets/clinical-migrator-password   # ref: dlc/qa/clinical-mongo/migrator-password
DLC_CLINICAL_RUNTIME_PASSWORD_FILE=/run/dlc-secrets/clinical-runtime-password       # ref: dlc/qa/clinical-mongo/runtime-password
DLC_CLINICAL_BACKUP_PASSWORD_FILE=/run/dlc-secrets/clinical-backup-password         # ref: dlc/qa/clinical-mongo/backup-password
# Backup storage location, frequency and retention are pending decision P-03.
DLC_MONGO_BACKUP_DIR=/var/backups/dlc-clinical-mongo
# TLS is required in this stage: start with -f compose.yml -f compose.tls.yml.
DLC_MONGO_TLS_CERTIFICATE_FILE=/run/dlc-secrets/mongo-tls-certificate.pem   # ref: dlc/qa/clinical-mongo/tls-certificate
DLC_MONGO_TLS_CA_FILE=/run/dlc-secrets/mongo-tls-ca.pem                     # ref: dlc/qa/clinical-mongo/tls-ca
